# Single source of truth for Qt versions (KEY=VALUE, no spaces around '=').
#
# Migrating (e.g. Qt 6.11 -> 6.12): update QT_VERSION below. Local scripts
# (windeploy.bat, make-installer.bat, build.cmd, linuxdeploy.sh,
# macdeploy.sh) and the Linux CI jobs pick it up automatically.
#
# Windows CI installers stay pinned to 6.10 because of Qt bugs; bump
# QT_VERSION_WINDOWS_CI once those are fixed.
#
# macOS CI installs Qt via Homebrew (rolling qt@6), so it has no pin here.
QT_VERSION=6.11.1
QT_VERSION_WINDOWS_CI=6.10.1
